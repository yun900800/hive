# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# google oauth client downloads (contain client_secret)
**/client_secret*.json
**/client_secret*.json.*

# n8n 发票交付物 —— 这是要单独售卖的商品，仓库是 public，不随代码公开
# （含工作流本体、买家文档、测试载荷，以及一份第三方模板的 Google 资源 id）
docs/n8n/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# local database (SQLite files)
/data
*.db
*.db-shm
*.db-wal

# temporary / session files
/.tmp
/.playwright-mcp
/ui-*.png

# opencode agent workspace
/.opencode

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*
